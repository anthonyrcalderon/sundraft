# Dependencies
node_modules/

# Env files — these hold real secrets (Mapbox token, later AWS values),
# never commit them. .env.example is the template that's safe to commit.
.env
.env.local
.env.*.local

# Build output
dist/
build/

# Mock server's live local data — regenerated from db.seed.json on first run,
# changes constantly as you use the app locally, never meant to be committed.
mock-server/db.json

# Vite
.vite/

# CDK
infra/cdk.out/

# Logs
npm-debug.log*
*.log

# OS/editor cruft
.DS_Store
.vscode/
.idea/
