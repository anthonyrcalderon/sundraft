# Copy to .env.local. Defaults to the mock server if unset.
VITE_API_BASE_URL=http://localhost:4000/api

# Milestone 2 (map + address search) needs no API key or token at all —
# it's built on MapLibre GL JS + Esri World Imagery + Nominatim, all free
# with no signup required. See docs/PROJECT-OVERVIEW.md for why.

# Gates the "Admin" toggle in the UI (create/edit example templates in
# place). This is a UI speed bump only, not real security — the backend
# accepts any request carrying an X-Admin: true header, admin or not. See
# frontend/src/api/adminAuth.ts.
VITE_ADMIN_PASSWORD=
