# Copy to .env.local. Defaults to the mock server if unset.
VITE_API_BASE_URL=http://localhost:4000/api

# Required for Milestone 2 (map + address search). Get a free token at
# https://account.mapbox.com/ — the free tier covers 50,000 map loads and
# 100,000 geocoding requests per month, plenty for a demo.
VITE_MAPBOX_TOKEN=your_mapbox_token_here
